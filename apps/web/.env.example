# API mode requires all four values. Endpoint paths are intentionally configurable
# until the backend contract confirms its routes. Paths may use the shown tokens.
VITE_API_BASE_URL=
VITE_SURVEY_PLAN_PATH=/api/survey-plans/{destinationId}
VITE_SURVEY_PROGRESS_PATH=/api/survey-plans/{planId}/progress
VITE_SURVEY_SUBMIT_PATH=/api/survey-plans/{planId}/submissions

# true: always use local SurveyPlanV4 fixtures
# false: always use the API and surface configuration/network errors
# unset: use fixtures only in Vite development; production uses the API
VITE_USE_MOCK_SURVEY=
