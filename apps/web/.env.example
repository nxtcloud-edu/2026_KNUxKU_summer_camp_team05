# MOA web — data source configuration.
#
# The browser only ever talks to the MOA backend. Travel, map, transit, weather
# and LLM providers are called by the server, never from here.

# Backend origin. Required for api mode (cookies need an exact origin, so the
# backend must list this app's origin in WEB_ORIGIN).
VITE_API_BASE_URL=

# mock | api. Leave empty to decide from VITE_API_BASE_URL:
#   set   -> api  (real rooms, real survey submit, real progress and results)
#   unset -> mock (fixtures only; the demo runs with no backend)
VITE_MOA_DATA_MODE=

# Survey-only override, kept for compatibility with the earlier setup.
# true: always use the local SurveyPlanV4 fixtures
# false: always use the backend
# unset: follow VITE_MOA_DATA_MODE
VITE_USE_MOCK_SURVEY=

# Optional. The backend has no survey-plan endpoint yet, so the question script
# comes from local fixtures unless all three paths are configured. The final
# submission always goes to POST /api/survey-responses with the x-room-id header.
VITE_SURVEY_PLAN_PATH=
VITE_SURVEY_PROGRESS_PATH=
VITE_SURVEY_SUBMIT_PATH=
