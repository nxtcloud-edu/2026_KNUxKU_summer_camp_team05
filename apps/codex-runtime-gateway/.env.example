MOA_GATEWAY_HOST=127.0.0.1
MOA_GATEWAY_PORT=4600
# 기본값은 :memory:이며 프로세스 종료 시 결과와 thread binding이 사라진다.
MOA_GATEWAY_DB=:memory:
# Codex가 읽을 수 있는 빈 로컬 작업공간. 저장소나 사용자 홈을 지정하지 않는다.
MOA_AGENT_WORKSPACE=/private/tmp/moa-codex-runtime
# 로그인 뒤 /internal/v1/models에서 확인한 모델만 쉼표로 넣는다. 지금은 비워 둔다.
MOA_MODEL_PROFILE_FAST=
MOA_MODEL_PROFILE_BALANCED=
MOA_MODEL_PROFILE_DEEP_REASONING=
MOA_MODEL_CATALOG_TTL_SECONDS=300
# 토큰·이메일이 아닌 인증 경계의 익명 이름이다.
MOA_AUTH_BOUNDARY_ID=team05-local-codex
MOA_WORKSPACE_ID=
