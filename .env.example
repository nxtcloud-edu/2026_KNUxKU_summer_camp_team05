# 로컬 개발용 환경변수 예시. 복사해서 .env로 쓰고, 실제 키는 절대 커밋하지 않는다.
#   cp .env.example .env
# 운영 값은 GitHub Actions Secrets 또는 배포 환경의 시크릿 저장소에서 주입한다.
# 근거: docs/development-and-deployment.md 4.3 · 7.5

# ── 런타임 ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3001
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173

# ── 데이터스토어 (docker-compose.yml 기본값) ────────────────────────────────
DATABASE_URL=postgres://tm:tm_local@localhost:5432/travel_mediation
REDIS_URL=redis://127.0.0.1:6379
# 워커를 띄우기 전까지는 false로 둔다. true면 이의가 실제로 큐에 등록된다.
ENABLE_QUEUE=false

# ── 실행 상한 ─────────────────────────────────────────────────────────────
RUN_WALLCLOCK_LIMIT_SEC=1800
RUN_COST_CAP_USD=0.6
ROUND_TURN_CAP=32
ROUND_RERUN_CAP=2
GLOBAL_RECALC_CAP=3
WORKER_CONCURRENCY=1
OBJECTION_CAP_PER_ROOM=3
OBJECTION_CAP_PER_USER=1

# ── LLM (packages/agents 착수 시) ──────────────────────────────────────────
# 역할별로 모델을 나누는 이유는 원가다. 상세는 docs/llm-runtime-config.md.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_SUPERVISOR=claude-opus-5
LLM_MODEL_REFEREE=claude-sonnet-5
LLM_MODEL_PERSONA=claude-haiku-4-5
# 비동기 배치 실행 모델이므로 Batch API를 기본으로 쓴다 (토큰 단가 50% 절감).
LLM_USE_BATCH=true
# 라운드 내 공유 프리픽스를 캐시한다. 모델별 최소 캐시 길이가 다르다 (문서 3장).
LLM_PROMPT_CACHE=true

# ── 웹 조달·RAG (packages/data-agents, advisory 전용) ──────────────────────
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_CALLS_PER_ROUND=3

# ── 여행 API (심판 착수 시) ────────────────────────────────────────────────
# Amadeus는 테스트 환경과 운영 환경의 데이터가 다르다. 테스트 키로 실서비스 금지.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
RAKUTEN_APPLICATION_ID=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
ODSAY_API_KEY=
NAVITIME_API_KEY=
TOURAPI_SERVICE_KEY=
HOTPEPPER_API_KEY=
KAKAO_REST_API_KEY=
KOREAEXIM_FX_API_KEY=

# ── 인증 (API 퍼블릭 노출의 전제) ──────────────────────────────────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
SESSION_SECRET=

# ── 프론트엔드는 apps/web/.env 를 따로 쓴다 ────────────────────────────────
# VITE_API_BASE_URL=http://localhost:3001
