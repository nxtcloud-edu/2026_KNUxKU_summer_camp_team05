# 로컬 개발용 환경변수 예시. 복사해서 .env로 쓰고, 실제 키는 절대 커밋하지 않는다.
#   cp .env.example .env
# 운영 값은 GitHub Actions Secrets 또는 배포 환경의 시크릿 저장소에서 주입한다.
# 근거: docs/development-and-deployment.md 4.3 · 7.5

# ── 런타임 ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3001
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173

# ── 데이터스토어 (docker-compose.yml 기본값) ────────────────────────────────
DATABASE_URL=postgres://tm:tm_local@localhost:5432/travel_mediation
REDIS_URL=redis://127.0.0.1:6379
# 워커를 띄우기 전까지는 false로 둔다. true면 이의가 실제로 큐에 등록된다.
ENABLE_QUEUE=false

# ── 실행 상한 ─────────────────────────────────────────────────────────────
RUN_WALLCLOCK_LIMIT_SEC=1800
RUN_COST_CAP_USD=0.6
ROUND_TURN_CAP=32
ROUND_RERUN_CAP=2
GLOBAL_RECALC_CAP=3
WORKER_CONCURRENCY=1
OBJECTION_CAP_PER_ROOM=3
OBJECTION_CAP_PER_USER=1

# ── LLM (packages/agents) ─────────────────────────────────────────────────
# 제공자는 Gemini 무료 티어다. 그래서 상한의 성질이 바뀐다 —
# run을 죽이는 것은 비용(0원)이 아니라 레이트리밋(429)이다.
# 위의 RUN_COST_CAP_USD는 무료 티어에서 아무것도 막지 못한다.
GEMINI_API_KEY=
GEMINI_MODEL_SUPERVISOR=gemini-2.5-flash
GEMINI_MODEL_REFEREE=gemini-2.5-flash
GEMINI_MODEL_PERSONA=gemini-2.5-flash-lite
GEMINI_MODEL_DOCUMENT=gemini-2.5-flash
# 실제 상한. 기본값은 일부러 보수적이다 — 넘겨 잡으면 429를 맞고 낮게 잡으면 느릴 뿐이다.
# 현재 한도는 https://ai.google.dev/gemini-api/docs/rate-limits 에서 확인하고 올린다.
GEMINI_RPM=10
GEMINI_RPD=200

# ── 웹 조달·RAG (packages/data-agents, advisory 전용) ──────────────────────
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_CALLS_PER_ROUND=3

# ── 여행 API ───────────────────────────────────────────────────────────────
# 2026-08-14 재조사 기준. 키가 없는 제공자는 어댑터를 만들지 않고 무엇이 빠졌는지
# 로그에 남긴다 (packages/data-agents/src/providers/registry.ts).
# 하나도 없으면 demo-fixture가 켜져 파이프라인은 끝까지 돈다 — 단 배지가 PARTIAL이다.

# 일본 숙소. 무료. 1 req/sec 상한. 첫 수직 경로(오사카·3인·3박)의 핵심.
# 2026-05-14 개편으로 accessKey가 필수가 됐고 구 도메인(app.rakuten.co.jp)은 폐지됐다.
# **앱 종류를 반드시 「サーバーアプリ(백엔드)」로 등록한다.** 「Webアプリケーション」으로
# 등록하면 브라우저 Referer를 검사하는데 워커는 그 헤더가 없어 전부 403이 된다.
# 서버앱은 대신 허용 IP를 등록한다 — curl -s https://api.ipify.org 로 확인.
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
# 일본 식당. 무료. **크레딧 표시가 의무다** — 화면에 로고 또는 텍스트를 넣어야 한다.
HOTPEPPER_API_KEY=
# 국내 관광지·음식점·숙박. 공공데이터포털. 개발계정 1,000건/일.
# 현행 서비스는 KorService2다 (KorService1은 세대 교체됨).
TOURAPI_SERVICE_KEY=
# 국내 장소 검색·좌표 변환. 각 오퍼레이션 100,000건/일. 상업 이용 제한 없음.
# 주의: 2026-07-21부터 개발자 계정당 **첫 활성 앱만** 무료 쿼터다.
KAKAO_REST_API_KEY=
# 국내 대중교통 경로. 1,000건/일. **무료 티어는 비상업 목적 한정**이고
# 개인·학생·5인 이하 스타트업만 쓸 수 있다.
ODSAY_API_KEY=
# 항공 최저가. 제휴 가입 후 무료 토큰. 200 req/hour/IP.
# 캐시된 과거 검색가라 flight.cheapest_date에만 쓰고 예약 근거로 삼지 않는다.
TRAVELPAYOUTS_TOKEN=
# 환율. Frankfurter(api.frankfurter.dev)는 키가 필요 없다. 이건 대체 경로용.
KOREAEXIM_FX_API_KEY=

# ── 쓰지 않는 제공자와 이유 ────────────────────────────────────────────────
# AMADEUS_*        Self-Service 포털이 2026-07-17에 완전 종료. 신규 등록 불가.
# NAVITIME_API_KEY 상용 유료. 무료 티어 없음.
# GOOGLE_*         SKU별 무료 한도(Essentials 10k/Pro 5k/Enterprise 1k 월)는 있으나
#                  결제 계정(카드) 등록이 전제다. 캠프 기간에는 켜지 않는다.
# 날씨는 Open-Meteo를 키 없이 쓴다. **비상업 목적 한정이고 CC-BY 4.0 표기가 필요하다.**

# 실제 키가 하나도 없어도 데모 제공자로 완주한다. 강제로 켜려면 true.
USE_DEMO_PROVIDER=

# ── 인증 (API 퍼블릭 노출의 전제) ──────────────────────────────────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
SESSION_SECRET=

# ── 프론트엔드는 apps/web/.env 를 따로 쓴다 ────────────────────────────────
# VITE_API_BASE_URL=http://localhost:3001
