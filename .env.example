# 로컬 개발용 환경변수 예시. 복사해서 .env로 쓰고, 실제 키는 절대 커밋하지 않는다.
#   cp .env.example .env
# 운영 값은 GitHub Actions Secrets 또는 배포 환경의 시크릿 저장소에서 주입한다.
# 근거: docs/development-and-deployment.md 4.3 · 7.5

# ── 런타임 ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3001
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173

# ── 데이터스토어 (docker-compose.yml 기본값) ────────────────────────────────
DATABASE_URL=postgres://tm:tm_local@localhost:5432/travel_mediation
REDIS_URL=redis://127.0.0.1:6379
# 워커를 띄우기 전까지는 false로 둔다. true면 이의가 실제로 큐에 등록된다.
ENABLE_QUEUE=false

# ── 실행 상한 ─────────────────────────────────────────────────────────────
RUN_WALLCLOCK_LIMIT_SEC=1800
RUN_COST_CAP_USD=0.6
ROUND_TURN_CAP=32
ROUND_RERUN_CAP=2
GLOBAL_RECALC_CAP=3
WORKER_CONCURRENCY=1
OBJECTION_CAP_PER_ROOM=3
OBJECTION_CAP_PER_USER=1

# ── LLM (packages/agents) ─────────────────────────────────────────────────
# 제공자는 Gemini 무료 티어다. 그래서 상한의 성질이 바뀐다 —
# run을 죽이는 것은 비용(0원)이 아니라 레이트리밋(429)이다.
# 위의 RUN_COST_CAP_USD는 무료 티어에서 아무것도 막지 못한다.
GEMINI_API_KEY=
GEMINI_MODEL_SUPERVISOR=gemini-2.5-flash
GEMINI_MODEL_REFEREE=gemini-2.5-flash
GEMINI_MODEL_PERSONA=gemini-2.5-flash-lite
GEMINI_MODEL_DOCUMENT=gemini-2.5-flash
# 실제 상한. 기본값은 일부러 보수적이다 — 넘겨 잡으면 429를 맞고 낮게 잡으면 느릴 뿐이다.
# 현재 한도는 https://ai.google.dev/gemini-api/docs/rate-limits 에서 확인하고 올린다.
GEMINI_RPM=10
GEMINI_RPD=200

# ── 웹 조달·RAG (packages/data-agents, advisory 전용) ──────────────────────
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_CALLS_PER_ROUND=3

# ── 여행 API (심판 착수 시) ────────────────────────────────────────────────
# Amadeus는 테스트 환경과 운영 환경의 데이터가 다르다. 테스트 키로 실서비스 금지.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
RAKUTEN_APPLICATION_ID=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
ODSAY_API_KEY=
NAVITIME_API_KEY=
TOURAPI_SERVICE_KEY=
HOTPEPPER_API_KEY=
KAKAO_REST_API_KEY=
KOREAEXIM_FX_API_KEY=

# ── 인증 (API 퍼블릭 노출의 전제) ──────────────────────────────────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
SESSION_SECRET=

# ── 프론트엔드는 apps/web/.env 를 따로 쓴다 ────────────────────────────────
# VITE_API_BASE_URL=http://localhost:3001
