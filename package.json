{
  "name": "moa-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "MOA — 멀티 에이전트 여행 계획 중재 서비스 모노레포",
  "engines": {
    "node": ">=20.10.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tm/web",
    "dev:web": "npm run dev --workspace @tm/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:agents",
    "test:agents": "python -m pytest -c packages/agents/pyproject.toml packages/agents/tests",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down",
    "local:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
